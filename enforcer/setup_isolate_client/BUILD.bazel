load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//enforcer:__subpackages__"])

rust_library(
    name = "setup_isolate_client",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "setup_isolate_client",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
    deps = [
        "//enforcer/junction:junction_trait",
        "//enforcer/v1:data_scope_rust",
        "//enforcer/v1:enforcer_rust",
        "//enforcer/v1:payload_rust",
        "//enforcer/v2:setup_isolate_rust_proto",
        "@crates//:anyhow",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:rand",
    ],
)

rust_test(
    name = "setup_isolate_client_test",
    size = "small",
    srcs = ["test/setup_isolate_client_test.rs"],
    deps = [
        ":setup_isolate_client",
        "//enforcer/error:ez_error",
        "//enforcer/isolate:isolate_info",
        "//enforcer/junction:junction_trait",
        "//enforcer/v1:enforcer_rust",
        "//enforcer/v1:payload_rust",
        "//enforcer/v2:setup_isolate_rust_proto",
        "@crates//:anyhow",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)
