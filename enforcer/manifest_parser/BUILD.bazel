load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "manifest_parser",
    srcs = glob(["src/*.rs"]),
    compile_data = [
        "//enforcer/proto:manifest_v1_descriptor_set",
        "//enforcer/proto:manifest_v2_descriptor_set",
    ],
    rustc_env = {
        "MANIFEST_V1_DESCRIPTOR_SET_PATH": "$(execpath //enforcer/proto:manifest_v1_descriptor_set)",
        "MANIFEST_V2_DESCRIPTOR_SET_PATH": "$(execpath //enforcer/proto:manifest_v2_descriptor_set)",
    },
    visibility = ["//visibility:public"],
    deps = [
        "//enforcer/v1:data_scope_rust",
        "//enforcer/v1:enforcer_rust",
        "//enforcer/v1:manifest_rust",
        "//enforcer/v2:ez_backend_dependencies_rust_proto",
        "//enforcer/v2:ez_service_spec_rust_proto",
        "//enforcer/v2:intercepting_services_rust_proto",
        "//enforcer/v2:isolate_metrics_policy_rust_proto",
        "//enforcer/v2:isolate_runtime_config_rust_proto",
        "//enforcer/v2:opaque_isolate_manifest_rust_proto",
        "//enforcer/v2:ratified_isolate_manifest_rust_proto",
        "//enforcer/v2:setup_isolate_manifest_rust_proto",
        "@crates//:anyhow",
        "@crates//:prost-reflect",
        "@crates//:serde_json",
        "@crates//:thiserror",
    ],
)

filegroup(
    name = "testdata",
    srcs = glob([
        "test/testdata/*.json",
        "test/testdata/*.txtpb",
    ]),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "v1_test",
    size = "small",
    srcs = ["test/v1_test.rs"],
    compile_data = [
        "//enforcer/proto:manifest_v1_descriptor_set",
    ],
    data = [
        ":testdata",
        "//enforcer/proto:manifest_v1_descriptor_set",
    ],
    rustc_env = {
        "MANIFEST_V1_DESCRIPTOR_SET_PATH": "$(execpath //enforcer/proto:manifest_v1_descriptor_set)",
    },
    deps = [
        ":manifest_parser",
        "//enforcer/v1:data_scope_rust",
        "//enforcer/v1:manifest_rust",
        "@crates//:anyhow",
        "@crates//:prost-reflect",
    ],
)

rust_test(
    name = "v2_test",
    size = "small",
    srcs = ["test/v2_test.rs"],
    data = [
        ":testdata",
    ],
    deps = [
        ":manifest_parser",
        "@crates//:anyhow",
    ],
)
