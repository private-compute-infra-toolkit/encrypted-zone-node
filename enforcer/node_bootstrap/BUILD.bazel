load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//enforcer:__subpackages__"])

rust_library(
    name = "node_bootstrap",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "node_bootstrap",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
    deps = [
        "//enforcer/container/manager:container_manager_requester",
        "//enforcer/ez_management",
        "//enforcer/ez_to_ez:inbound_ez_to_ez_handler",
        "//enforcer/ez_to_ez:mtls",
        "//enforcer/ez_to_ez:outbound_ez_to_ez_client",
        "//enforcer/isolate:isolate_info",
        "//enforcer/setup_isolate_client",
        "//enforcer/state:state_manager",
        "@crates//:anyhow",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "v1_test",
    size = "small",
    srcs = ["test/v1_test.rs"],
    args = ["--test-threads=1"],
    data = [
        "//enforcer/ez_to_ez:testdata",
    ],
    deps = [
        ":node_bootstrap",
        "//enforcer/container/manager:container_manager_request",
        "//enforcer/container/manager:container_manager_requester",
        "//enforcer/data_scope",
        "//enforcer/error:ez_error",
        "//enforcer/ez_to_ez:inbound_ez_to_ez_handler",
        "//enforcer/ez_to_ez:outbound_ez_to_ez_client",
        "//enforcer/isolate:isolate_info",
        "//enforcer/junction:junction_trait",
        "//enforcer/setup_isolate_client",
        "//enforcer/state:state_manager",
        "//enforcer/v1:data_scope_rust",
        "//enforcer/v1:enforcer_rust",
        "//enforcer/v1:ez_mtls_rust",
        "//enforcer/v1:payload_rust",
        "//enforcer/v2:common_rust_proto",
        "//enforcer/v2:setup_isolate_rust_proto",
        "@crates//:anyhow",
        "@crates//:prost",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
    ],
)

rust_test(
    name = "node_bootstrap_test",
    size = "small",
    srcs = ["test/node_bootstrap_test.rs"],
    args = ["--test-threads=1"],
    data = [
        "//enforcer/ez_to_ez:testdata",
    ],
    deps = [
        ":node_bootstrap",
        "//enforcer/container/manager:container_manager_request",
        "//enforcer/container/manager:container_manager_requester",
        "//enforcer/data_scope",
        "//enforcer/error:ez_error",
        "//enforcer/ez_to_ez:inbound_ez_to_ez_handler",
        "//enforcer/ez_to_ez:outbound_ez_to_ez_client",
        "//enforcer/isolate:isolate_info",
        "//enforcer/junction:junction_test_utils",
        "//enforcer/junction:junction_trait",
        "//enforcer/setup_isolate_client",
        "//enforcer/state:state_manager",
        "//enforcer/v1:data_scope_rust",
        "//enforcer/v1:enforcer_rust",
        "//enforcer/v1:payload_rust",
        "//enforcer/v2:common_rust_proto",
        "//enforcer/v2:ez_management_rust",
        "//enforcer/v2:opaque_isolate_manifest_rust_proto",
        "//enforcer/v2:ratified_isolate_manifest_rust_proto",
        "//enforcer/v2:setup_isolate_rust_proto",
        "@crates//:anyhow",
        "@crates//:prost",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
    ],
)
